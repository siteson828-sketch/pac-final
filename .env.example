# Public Art Collections — environment variables.
# Copy to .env.local and fill in. All integrations no-op cleanly when unset.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Museum sync source API keys (optional per source) ---
NYPL_TOKEN=
TEPAPA_KEY=
EUROPEANA_KEY=
SMITHSONIAN_KEY=
DPLA_KEY=
HARVARD_KEY=

# --- Sync/cron auth ---
CRON_SECRET=
SYNC_SECRET=

# --- Stripe (checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Printful (fulfillment) ---
PRINTFUL_API_KEY=

# --- Twilio (owner SMS alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_NOTIFY_TO=

# --- AudienceLab (visitor pixel) ---
NEXT_PUBLIC_AUDIENCELAB_PIXEL_ID=
NEXT_PUBLIC_AUDIENCELAB_SRC=

# --- Bloo.io (CRM + SMS) ---
BLOO_API_KEY=
# Sender number for outbound marketing SMS (see pages/api/track.js). Only send
# to numbers with lawful marketing consent + STOP/opt-out handling (TCPA/CTIA).
BLOO_PHONE_NUMBER=

# --- Checkout anti-abuse ---
# HMAC secret used to sign short-lived checkout session tokens. When unset,
# /api/create-order token verification is skipped (fail-open) — SET THIS in
# production so the order endpoint actually rejects scripted requests.
ORDER_TOKEN_SECRET=
