# Public Art Collections — environment variables.
# Copy to .env.local and fill in. All integrations no-op cleanly when unset.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Museum sync source API keys (optional per source) ---
NYPL_TOKEN=
TEPAPA_KEY=
EUROPEANA_KEY=
SMITHSONIAN_KEY=
DPLA_KEY=
HARVARD_KEY=

# --- Sync/cron auth ---
CRON_SECRET=
SYNC_SECRET=

# --- Stripe (checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Printful (fulfillment) ---
PRINTFUL_API_KEY=

# --- Twilio (owner SMS alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_NOTIFY_TO=

# --- AudienceLab (visitor pixel) ---
NEXT_PUBLIC_AUDIENCELAB_PIXEL_ID=
NEXT_PUBLIC_AUDIENCELAB_SRC=

# --- Bloo.io (CRM) ---
BLOO_API_KEY=
