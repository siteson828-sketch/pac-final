# Public Art Collections — environment variables.
# Copy to .env.local and fill in. All integrations no-op cleanly when unset.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Auth (NextAuth.js) ---
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical site origin. Use the www host — the apex 308-redirects to www, and
# OAuth callbacks/cookies must target the host actually served or the Google
# flow breaks on the redirect.
NEXTAUTH_URL=https://www.publicartcollections.net
# Google OAuth — https://console.cloud.google.com/apis/credentials
#   JS origin:     https://www.publicartcollections.net
#   redirect URI:  https://www.publicartcollections.net/api/auth/callback/google
# Until both are set, email/password works and the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Museum sync source API keys (optional per source) ---
NYPL_TOKEN=
TEPAPA_KEY=
EUROPEANA_KEY=
SMITHSONIAN_KEY=
DPLA_KEY=
HARVARD_KEY=
# Aggregator source keys (register free). Sources no-op until their key is set.
TROVE_KEY=          # register: trove.nla.gov.au/about/create-something/using-api
DIGITALNZ_KEY=      # register: digitalnz.org/developers
BHL_KEY=            # register: biodiversitylibrary.org/getapikey

# --- Sync/cron auth ---
CRON_SECRET=
SYNC_SECRET=

# --- Stripe (checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Subscription tiers. Create via GET /api/setup-subscription-prices?secret=<SYNC_SECRET>
# (creates the products, monthly prices, and webhook endpoint), then set these.
STRIPE_PRICE_COLLECTOR=
STRIPE_PRICE_TRADE=
# Webhook signing secret (whsec_…) for /api/stripe-webhook — returned by the setup call.
STRIPE_WEBHOOK_SECRET=

# --- Printful (fulfillment) ---
PRINTFUL_API_KEY=

# --- Owner alerts ---
# Destination number for owner order alerts, sent via Bloo.io SMS
# (uses BLOO_API_KEY + BLOO_PHONE_NUMBER below).
OWNER_PHONE_NUMBER=

# --- AudienceLab (visitor pixel) ---
NEXT_PUBLIC_AUDIENCELAB_PIXEL_ID=
NEXT_PUBLIC_AUDIENCELAB_SRC=
# Shared secret protecting /api/audiencelab-webhook (it writes sensitive PII —
# never leave it open). Put it in the AudienceLab webhook URL as ?secret=... or
# an x-webhook-secret header. Endpoint fails closed if unset.
WEBHOOK_SECRET=

# --- GoHighLevel (CRM + journey tracking) ---
# Location API key (Bearer). CRM push + journey events no-op until this is set.
GHL_API_KEY=
GHL_LOCATION_ID=
# Set to exactly "true" to start firing client-side journey events (artwork_view,
# order_started, cart_started/abandoned, order_completed) to /api/ghl-event.
# Public (bundled to the browser). Leave unset to generate zero extra traffic.
NEXT_PUBLIC_GHL_ENABLED=
# Shared secret protecting /api/ghl-webhook (it can send SMS — never leave open).
# Put it in the GHL webhook URL as ?secret=... or an x-ghl-secret header.
GHL_WEBHOOK_SECRET=

# --- Bloo.io (CRM + SMS) ---
BLOO_API_KEY=
# Sender number for outbound SMS (owner alerts + visitor marketing).
BLOO_PHONE_NUMBER=
# Opt-in flag for VISITOR marketing SMS. Off by default: setting BLOO_API_KEY
# enables owner order alerts only. Set to exactly "true" to start texting
# visitors (first visit, when a phone is known). Only enable with lawful
# marketing consent + STOP/opt-out handling (TCPA/CTIA).
ENABLE_VISITOR_SMS=

# --- Email (Resend) — welcome + drip follow-ups to opted-in leads ---
# Provision via: vercel integration add resend/resend-email  (injects RESEND_API_KEY).
# Email no-ops cleanly until RESEND_API_KEY is set. Verify the sending domain in
# the Resend dashboard (DNS/SPF/DKIM) before sending from your own address.
RESEND_API_KEY=
# Verified sender, e.g. "Public Art Collections <hello@publicartcollections.net>"
RESEND_FROM_EMAIL=
# Physical postal address shown in marketing email footers (CAN-SPAM requirement).
MAIL_POSTAL_ADDRESS=

# --- Checkout anti-abuse ---
# HMAC secret used to sign short-lived checkout session tokens. When unset,
# /api/create-order token verification is skipped (fail-open) — SET THIS in
# production so the order endpoint actually rejects scripted requests.
ORDER_TOKEN_SECRET=
